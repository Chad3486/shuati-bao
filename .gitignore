# 不再入库 —— 此前 dist/*.html 与 assets/app.html 是同一份内容存两遍，每次构建重写，白涨 git 历史
/dist/
dist/*.docx
dist/tesseract

# 构建产物（Gradle / Node）
apk-src/app/build/
apk-src/build/
apk-src/.gradle/
build/
.gradle/
node_modules/

# 本地环境与 IDE
apk-src/local.properties
.idea/
*.iml
.DS_Store

# 打包产物（随 Release 分发，不入库）
*.apk
