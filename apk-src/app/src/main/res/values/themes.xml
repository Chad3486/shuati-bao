<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 轻量构建不引入 appcompat：MainActivity 已改为系统 Activity，parent 换平台 Material 主题；
         style 名保持不变（Manifest 引用不动）。windowActionBar 为 appcompat 专属属性，移除 -->
    <style name="Theme.AppCompat.Light.NoActionBar.Fullscreen" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#1652f0</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
